# Base de données
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_sous_traitants?schema=public"

# Auth JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Stockage fichiers (local en dev ; S3-compatible en prod, ex. Cloudflare R2)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_PUBLIC_URL_BASE=""

# Emails transactionnels (Resend)
RESEND_API_KEY=""
EMAIL_FROM="notifications@example.com"

# Stripe (abonnement SaaS agence) — clés de test d'abord (sk_test_..., whsec_...)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""

# Cron externe (Render free tier ne garde pas de process en tâche de fond :
# un pingeur externe doit appeler POST /api/internal/cron/run avec ce secret
# en en-tête x-cron-secret, une fois par jour)
CRON_SECRET="change-me-cron-secret"

# Panel admin support (page /admin/support côté web) — secret partagé,
# à saisir une fois dans le navigateur, envoyé en en-tête x-support-secret
SUPPORT_ADMIN_SECRET="change-me-support-secret"

# API
API_PORT=3001
WEB_URL="http://localhost:3000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
