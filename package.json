{
  "name": "gestion-sous-traitants",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "dotenv -e .env -- npm run start:dev -w apps/api",
    "dev:web": "dotenv -e .env -- npm run dev -w apps/web",
    "build": "npm run build -w packages/database && npm run build -w packages/shared-types && npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "db:generate": "dotenv -e .env -- npm run generate -w packages/database",
    "db:migrate": "dotenv -e .env -- npm run migrate -w packages/database",
    "db:seed": "dotenv -e .env -- npm run seed -w packages/database"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.5.4"
  }
}
